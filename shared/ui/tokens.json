{
  "$description": "NLWC EMS design tokens v1.0. Mirror of tokens.css.",
  "light": {
    "color.brand": {
      "ember-50": "#FDEBE3",
      "ember-100": "#FBD3C0",
      "ember-300": "#F4894F",
      "ember-400": "#FF7C18",
      "ember-500": "#E8651A",
      "ember-600": "#C2300F",
      "ember-700": "#B3260E",
      "ember-800": "#8E1B0A",
      "ember-900": "#5E1206",
      "flame-gradient": "linear-gradient(90deg, #B3260E 0%, #E8541A 55%, #F28216 100%)"
    },
    "color.neutral": {
      "stone-0": "#FFFFFF",
      "stone-50": "#FAF7F4",
      "stone-100": "#F3EEE9",
      "stone-200": "#E6DFD8",
      "stone-300": "#D2C9C0",
      "stone-400": "#A39B94",
      "stone-500": "#6B635C",
      "stone-600": "#5E5650",
      "stone-700": "#3F3A36",
      "stone-800": "#2B2724",
      "stone-900": "#17120F",
      "stone-950": "#0F0D0C"
    },
    "color.semantic": {
      "success-600": "#1F7A4D",
      "success-50": "#DCF5E6",
      "success-800": "#14532D",
      "warning-600": "#8A5A00",
      "warning-50": "#FDF0D0",
      "warning-800": "#7A4A00",
      "danger-600": "#B0123C",
      "danger-50": "#FBE4EA",
      "danger-800": "#8E1B12",
      "info-600": "#1D5FA8",
      "info-50": "#E3EEFB",
      "info-800": "#154A85",
      "info-bg": "var(--info-50)",
      "info-fg": "var(--info-800)",
      "info-solid": "var(--info-600)"
    },
    "color.event": {
      "accent-bootcamp": "#C2300F",
      "accent-singlz": "#7A2E5B",
      "accent-couples": "#1F6F78",
      "event-accent": "var(--ember-600)"
    },
    "color.role": {
      "bg": "var(--stone-50)",
      "surface": "var(--stone-0)",
      "surface-sunken": "var(--stone-100)",
      "surface-inverse": "var(--stone-950)",
      "border": "var(--stone-200)",
      "border-strong": "var(--stone-300)",
      "primary": "var(--ember-600)",
      "primary-hover": "var(--ember-700)",
      "on-primary": "#FFFFFF",
      "primary-subtle": "var(--ember-50)",
      "focus-ring": "#1D5FA8",
      "link": "var(--ember-700)",
      "ok-bg": "var(--success-50)",
      "ok-fg": "var(--success-800)",
      "ok-solid": "var(--success-600)",
      "warn-bg": "var(--warning-50)",
      "warn-fg": "var(--warning-800)",
      "warn-solid": "var(--warning-600)",
      "bad-bg": "var(--danger-50)",
      "bad-fg": "var(--danger-800)",
      "bad-solid": "var(--danger-600)"
    },
    "type": {
      "text": "var(--stone-900)",
      "text-muted": "var(--stone-500)",
      "text-inverse": "var(--stone-0)",
      "font-ui": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "font-display": "\"Marcellus\", \"Trajan Pro\", Georgia, serif",
      "font-mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
      "text-xs": "0.75rem",
      "text-sm": "0.875rem",
      "text-base": "1rem",
      "text-lg": "1.125rem",
      "text-xl": "1.25rem",
      "text-2xl": "1.5rem",
      "text-3xl": "1.875rem",
      "text-4xl": "2.25rem",
      "text-5xl": "3rem",
      "lh-tight": "1.2",
      "lh-snug": "1.35",
      "lh-body": "1.55"
    },
    "space": {
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "20px",
      "space-6": "24px",
      "space-8": "32px",
      "space-10": "40px",
      "space-12": "48px",
      "space-16": "64px"
    },
    "radius": {
      "radius-sm": "6px",
      "radius-md": "10px",
      "radius-lg": "16px",
      "radius-pill": "999px"
    },
    "shadow": {
      "shadow-1": "0 1px 2px rgb(23 18 15 / .08)",
      "shadow-2": "0 4px 14px rgb(23 18 15 / .10)",
      "shadow-3": "0 12px 32px rgb(23 18 15 / .16)"
    },
    "motion": {
      "dur-fast": "120ms",
      "dur-base": "200ms",
      "ease": "cubic-bezier(.2,.0,.0,1)"
    },
    "size": {
      "target-min": "44px",
      "target-device": "56px"
    }
  },
  "dark_overrides": {
    "bg": "var(--stone-950)",
    "surface": "var(--stone-900)",
    "surface-sunken": "#0A0807",
    "border": "var(--stone-800)",
    "border-strong": "var(--stone-700)",
    "text": "#F0EBE6",
    "text-muted": "var(--stone-400)",
    "primary": "#FF9A4D",
    "primary-hover": "#FFB07A",
    "on-primary": "var(--stone-950)",
    "primary-subtle": "#2E160C",
    "link": "#FF9A4D",
    "focus-ring": "#7DB4F5",
    "ok-bg": "#0F2A1B",
    "ok-fg": "#4ADE80",
    "ok-solid": "#4ADE80",
    "warn-bg": "#2E2208",
    "warn-fg": "#FBBF24",
    "warn-solid": "#FBBF24",
    "bad-bg": "#321019",
    "bad-fg": "#FF8A9E",
    "bad-solid": "#FF8A9E",
    "info-bg": "#0E2036",
    "info-fg": "#7DB4F5",
    "info-solid": "#7DB4F5"
  }
}